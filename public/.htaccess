Options -Indexes -ExecCGI -Includes
DirectoryIndex index.html
Require local
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteCond %{REMOTE_ADDR} !^127\.
RewriteCond %{REMOTE_ADDR} !^::1$
RewriteRule ^ - [F,L]
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
</IfModule>
