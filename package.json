{
  "name": "poker-odds-knowledge",
  "version": "2.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify:oracle": "tsx scripts/oracle-corpus.ts",
    "build:online": "tsc --noEmit && vite build --mode online --outDir online-dist",
    "test:appearance": "playwright test --config playwright.appearance.config.ts",
    "test:online": "playwright test --config playwright.online.config.ts",
    "start:online": "node --import tsx server/main.ts --test-mail",
    "notices": "node scripts/notices.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:engines": "tsc --noEmit && vite build --mode engine-preview --outDir engine-dist",
    "test:engines:browser": "playwright test --config playwright.engines.config.ts",
    "engines:compare": "tsx scripts/engine-comparison.ts",
    "build:web": "tsc --noEmit && vite build",
    "build:strategy": "tsc --noEmit && vite build --mode strategy-preview --outDir strategy-dist",
    "build:strategy:online": "tsc --noEmit && vite build --mode strategy-online --outDir strategy-online-dist",
    "build:android:web": "tsc --noEmit && vite build --mode android --outDir android-dist"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@hono/node-server": "2.1.3",
    "better-auth": "1.7.6",
    "hono": "4.13.11",
    "i18next": "26.4.2",
    "nodemailer": "10.0.13",
    "openai": "7.25.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.9.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.28.2",
    "flag-icons": "7.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
