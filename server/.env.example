# Generic references only. Supply real values through the deployment secret manager.
# Local launcher uses a private generated auth secret outside the public bundle.
NODE_ENV=production
POK_PORT=4318
POK_BASE_URL=https://YOUR_APPROVED_HOST
POK_DATA_DIR=/private/pok
POK_AUTH_SECRET=
POK_SMTP_HOST=
POK_SMTP_PORT=465
POK_SMTP_FROM=
POK_SMTP_USER=
POK_SMTP_PASSWORD=
POK_GOOGLE_CLIENT_ID=
POK_GOOGLE_CLIENT_SECRET=
POK_GOOGLE_APPROVED=false
POK_FACEBOOK_CLIENT_ID=
POK_FACEBOOK_CLIENT_SECRET=
POK_FACEBOOK_APPROVED=false
POK_TWITTER_CLIENT_ID=
POK_TWITTER_CLIENT_SECRET=
POK_TWITTER_APPROVED=false
POK_SNAPCHAT_CLIENT_ID=
POK_SNAPCHAT_CLIENT_SECRET=
POK_SNAPCHAT_APPROVED=false
# AI remains disabled; a key alone is never permission or budget to spend.
